# GentStyle Environment Configuration

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL="postgresql://gentstyle_user:gentstyle_secret@localhost:5432/gentstyle_db?schema=public"

# Redis Cache & Session
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET=super_secret_jwt_access_key_change_in_production_987654321
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_123456789
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Payment Gateways
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_mock_secret_key_gentstyle
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret_gentstyle
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_secret

# Image Storage (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=gentstyle-cloud
CLOUDINARY_API_KEY=mock_cloudinary_key
CLOUDINARY_API_SECRET=mock_cloudinary_secret

# Email Notification Service (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=mock_smtp_user
EMAIL_PASSWORD=mock_smtp_password
EMAIL_FROM="GentStyle Luxury Fashion <noreply@gentstyle.com>"

# Admin Default Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@gentstyle.com
DEFAULT_ADMIN_PASSWORD=AdminSecurePassword123!
